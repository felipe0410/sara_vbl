{
  "name": "saravbl",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && firebase deploy --only hosting",
    "emuladores": "firebase emulators:start --only auth,firestore --config firebase.emu.json --project sara-balaguera",
    "dev:emuladores": "NEXT_PUBLIC_EMULADOR=1 next dev"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "next": "^14.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "^14.2.0",
    "typescript": "^5"
  }
}
